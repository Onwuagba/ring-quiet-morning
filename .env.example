# Copy to .env. Everything is optional for local dev; the app runs with console email and stubbed Telegram/push.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
TIME_ZONE=Africa/Lagos
# Set SECURE_COOKIES=1 behind HTTPS
SECURE_COOKIES=0
# Ring (TODO-verify: real signature scheme unknown, see README)
RING_WEBHOOK_SECRET=dev-secret
RING_REPLAY_WINDOW_SECONDS=900
# Email (SMTP, e.g. Amazon SES SMTP endpoint: unverified here)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=quietmorning@localhost
#EMAIL_HOST=
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
# Telegram bot (create with @BotFather; see README). Without a token messages are logged stubs. Never commit the token.
TELEGRAM_BOT_TOKEN=
# Bot username WITHOUT the @, used to build t.me/<bot>?start=<token> links
TELEGRAM_BOT_USERNAME=
# Random string, 1-256 chars of A-Z a-z 0-9 _ - (e.g. python -c "import secrets;print(secrets.token_urlsafe(32))").
# Sent by Telegram in X-Telegram-Bot-Api-Secret-Token; the webhook rejects everything while this is empty.
TELEGRAM_WEBHOOK_SECRET=
# Web push (generate with: vapid --gen, or py_vapid). Needs HTTPS in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM=mailto:you@example.com
LOG_LEVEL=INFO

# ---- Optional AWS (all off by default; see docs/AWS_STACK.md). Needs `pip install -r requirements-aws.txt`. ----
# Postgres instead of SQLite (recommended for more than one worker: escalation uses row locks)
#DATABASE_URL=postgres://user:pass@host:5432/quietmorning
#AWS_REGION=us-east-1
# Bedrock Converse wording + weekly narrative. Choose a model ID your account can call (Nova Lite bare ID shown as a documented example;
# Claude Haiku 4.5 needs an inference-profile ID such as us.anthropic.claude-haiku-4-5-20251001-v1:0).
#BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
#BEDROCK_WORDING=1
#BEDROCK_GUARDRAIL_ID=
#BEDROCK_GUARDRAIL_VERSION=
#BEDROCK_DAILY_CALL_CAP=200
# Care-coordinator advisor (advisory only; can never suppress an escalation): off | bedrock | strands
#AI_ADVISOR=off
# SQS worker instead of Celery: python manage.py sqs_worker
#SQS_QUEUE_URL=
