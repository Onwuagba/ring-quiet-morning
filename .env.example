# Copy to .env. Everything is optional for local dev; the app runs with console email and stubbed SMS/WhatsApp/push.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SITE_URL=http://localhost:8000
TIME_ZONE=Africa/Lagos
# Set SECURE_COOKIES=1 behind HTTPS
SECURE_COOKIES=0
# Ring (TODO-verify: real signature scheme unknown, see README)
RING_WEBHOOK_SECRET=dev-secret
RING_REPLAY_WINDOW_SECONDS=900
# Email (SMTP, e.g. Amazon SES SMTP endpoint: unverified here)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=quietmorning@localhost
#EMAIL_HOST=
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
# Twilio SMS / WhatsApp: off unless flagged AND keyed. Without keys they are logged stubs.
SMS_ENABLED=0
WHATSAPP_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Web push (generate with: vapid --gen, or py_vapid). Needs HTTPS in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM=mailto:you@example.com
LOG_LEVEL=INFO
